# FlowTwin AI Environment Variables

# Backend Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/flowtwin

# Authentication
JWT_SECRET=flowtwin_enterprise_jwt_secret_dev_2026

# Optional: Google Gemini API Key for LLM Copilot (Deterministic AI fallback runs out-of-the-box if omitted)
GEMINI_API_KEY=

# Optional: OSRM Routing Provider URL
OSRM_ROUTING_URL=

# Google Maps Platform (Optional - Live Logistics Map works out-of-the-box in Keyless Mode)
# Leave empty for zero-configuration, zero-cost Autonomous Map (ESRI Dark Canvas, 100% free, no key needed)
# Or enter a Google Maps API key / free Demo Key to use Google Maps Platform:
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Environment
NODE_ENV=development
